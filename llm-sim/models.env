# 6 个开源模型批量部署配置（ModelScope 源）
# 格式: KEY=RELEASE:MODELSCOPE_MODEL_ID:PORT:PROFILE:MAX_MODEL_LEN:TRAFFIC_WEIGHT:REVISION
#   RELEASE : Helm release 名（同时作为 K8s Service/Deployment/ConfigMap 的前缀）
#   MODEL   : ModelScope 模型 ID（vllm launch render 通过 VLLM_USE_MODELSCOPE=True 加载）
#   PORT    : Service 端口（也作为 /metrics 暴露端口）
#   PROFILE : install.sh 中逐模型的性能 profile
#   MAX_MODEL_LEN  : 模型原生 context；不使用需要额外 YaRN/rope scaling 的扩展值
#   TRAFFIC_WEIGHT : bench.sh 自动发现 target 时的相对流量权重
#   REVISION       : ModelScope revision；默认 master，可改为仓库实际 tag/commit 固定版本
#
# 仅下载 tokenizer/processor/config/remote-code，6 个模型合计通常约 70-120MB，不下载权重。
DEEPSEEK_V4_PRO=deepseek-v4-pro:deepseek-ai/DeepSeek-V4-Pro:8001:deepseek-v4-pro:1000000:30:master
GLM_51=glm-51:ZhipuAI/GLM-5.1:8002:glm-51:202752:15:master
MINIMAX_M27=minimax-m27:MiniMax/MiniMax-M2.7:8003:minimax-m27:204800:12:master
QWEN3_32B=qwen3-32b:Qwen/Qwen3-32B:8004:qwen3-32b:32768:10:master
BAICHUAN2_13B_CHAT=baichuan2-13b-chat:baichuan-inc/Baichuan2-13B-Chat:8005:baichuan2-13b-chat:4096:8:master
QWEN35_122B_A10B=qwen35-122b-a10b:Qwen/Qwen3.5-122B-A10B:8006:qwen35-122b-a10b:262144:25:master

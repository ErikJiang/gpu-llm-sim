# 5 个模型批量部署配置（tokenizer 使用 ModelScope 源）
# 格式: KEY=RELEASE:SERVED_MODEL:TOKENIZER_MODEL:PORT:PROFILE:MAX_MODEL_LEN:TRAFFIC_WEIGHT:REVISION
#   RELEASE : Helm release 名（同时作为 K8s Service/Deployment/ConfigMap 的前缀）
#   SERVED_MODEL    : Dashboard 与 OpenAI API 暴露的模型名
#   TOKENIZER_MODEL : ModelScope 模型 ID，仅供 vllm launch render 做 tokenizer
#   PORT    : OpenAI API Service 端口；/metrics 固定由 exporter 的 9090 暴露
#   PROFILE : install.sh 中逐模型的性能 profile
#   MAX_MODEL_LEN  : 模型原生 context；不使用需要额外 YaRN/rope scaling 的扩展值
#   TRAFFIC_WEIGHT : bench.sh 自动发现 target 时的相对流量权重
#   REVISION       : ModelScope revision；默认 master，可改为仓库实际 tag/commit 固定版本
#
# 仅下载 tokenizer/processor/config/remote-code，不下载权重。
# MiniMax-M3 使用兼容 vLLM render 的 MiniMax-M2.7 tokenizer。
# Qwen3.7-Plus 是 API 产品，使用同系列公开 Qwen3.6-27B tokenizer。
GLM_52=glm-52:GLM-5.2:ZhipuAI/GLM-5.2:8001:glm-52:1000000:24:master
DEEPSEEK_V4_PRO=deepseek-v4-pro:DeepSeek-V4-Pro:deepseek-ai/DeepSeek-V4-Pro:8002:deepseek-v4-pro:1000000:17:master
MINIMAX_M3=minimax-m3:MiniMax-M3:MiniMax/MiniMax-M2.7:8003:minimax-m3:1000000:20:master
KIMI_K27_CODE=kimi-k27-code:Kimi-K2.7-Code:moonshotai/Kimi-K2.7-Code:8004:kimi-k27-code:262144:19:master
QWEN37_PLUS=qwen37-plus:Qwen3.7-Plus:Qwen/Qwen3.6-27B:8005:qwen37-plus:1000000:20:master

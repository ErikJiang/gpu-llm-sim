# 5 个开源模型批量部署配置（ModelScope 源，5 个不同家族）
# 格式: KEY=RELEASE:MODELSCOPE_MODEL_ID:PORT[:PROFILE]
#   RELEASE : Helm release 名（同时作为 K8s Service/Deployment/ConfigMap 的前缀）
#   MODEL   : ModelScope 模型 ID（vllm launch render 通过 VLLM_USE_MODELSCOPE=True 加载）
#   PORT    : Service 端口（也作为 /metrics 暴露端口）
#   PROFILE : 可选，small / balanced / large；缺省走 DEFAULT_PROFILE
#
# 5 个不同家族：Qwen / DeepSeek / InternLM / ChatGLM / Yi；tokenizer 均 < 50MB。
QWEN25_05B=qwen25-05b:qwen/Qwen2.5-0.5B-Instruct:8001:small
DEEPSEEK_R1_15B=deepseek-r1-15b:deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B:8002:balanced
INTERNLM2_18B=internlm2-18b:Shanghai_AI_Laboratory/internlm2-chat-1_8b:8003:balanced
CHATGLM3_6B=chatglm3-6b:ZhipuAI/chatglm3-6b:8004:large
YI_6B=yi-6b:01ai/Yi-1.5-6B-Chat:8005:large
